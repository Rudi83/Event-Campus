<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EventKampus">

        <!-- Login is the entry point that checks session -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register Account Activity -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Dashboard -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Event Details -->
        <activity
            android:name=".ui.detail.DetailEventActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Add or Edit Event (CRUD) -->
        <activity
            android:name=".ui.manage.AddEditEventActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Event Registration Form -->
        <activity
            android:name=".ui.register.RegisterEventActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Ticket & Slip View -->
        <activity
            android:name=".ui.ticket.TicketDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Admin: Kelola Peserta per Kegiatan -->
        <activity
            android:name=".ui.admin.ManageParticipantsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- User: Koleksi E-Sertifikat -->
        <activity
            android:name=".ui.certificate.MyCertificatesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Admin: Sesi Event Berlangsung -->
        <activity
            android:name=".ui.admin.EventSessionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- User: Absensi via Deep Link -->
        <activity
            android:name=".ui.attendance.AttendanceActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="eventkampus"
                    android:host="attendance" />
            </intent-filter>
        </activity>

        <!-- Location Picker: peta interaktif OSM untuk memilih lokasi kegiatan -->
        <activity
            android:name=".ui.map.LocationPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- BroadcastReceiver: Alarm event mulai & jendela absensi -->
        <receiver
            android:name=".receiver.EventAlarmReceiver"
            android:exported="false" />

        <!-- Campus Web Portal (In-App WebView) -->
        <activity
            android:name=".ui.web.CampusWebActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>