<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/stroke_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header gradien sertifikat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_certificate"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCertTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Seminar Nasional AI &amp; Perkembangan Masa Depan" />

                <TextView
                    android:id="@+id/tvCertOrganizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#CCffffff"
                    android:textSize="11sp"
                    tools:text="HIMATIF UNIMAL" />

            </LinearLayout>

            <!-- SKP Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#33FFFFFF"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tvCertSkp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SKP"
                    android:textColor="#CCffffff"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Detail info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/text_tertiary" />

                <TextView
                    android:id="@+id/tvCertDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Senin, 18 Nov 2026 • 09:00 WIB" />

                <!-- Status badge -->
                <TextView
                    android:id="@+id/tvCertStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/badge_free_container"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/badge_free"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="Disetujui" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/text_tertiary" />

                <TextView
                    android:id="@+id/tvCertLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Auditorium Utama Rektorat Lt. 3" />

            </LinearLayout>

            <!-- Nomor sertifikat -->
            <TextView
                android:id="@+id/tvCertNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#F0F4FF"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="@color/primary"
                android:textSize="11sp"
                tools:text="CERT/UNIMAL/EVT-001/TCK-123456" />

            <!-- Link Google Drive (muncul setelah link disimpan) -->
            <LinearLayout
                android:id="@+id/layoutCertLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/success_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_web"
                    app:tint="@color/badge_free" />

                <TextView
                    android:id="@+id/tvCertLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/badge_free"
                    android:textSize="11sp"
                    tools:text="drive.google.com/file/..." />

            </LinearLayout>

            <!-- Tombol aksi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Tombol input link — disembunyikan di halaman user, hanya admin dari Kelola Peserta -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInputLink"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Input Link"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:visibility="gone"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_web"
                    app:iconSize="15dp"
                    app:iconGravity="textStart"
                    app:strokeColor="@color/primary" />

                <!-- Tombol buka sertifikat (muncul setelah link diisi) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadCert"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Buka Sertifikat"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/badge_free"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_certificate"
                    app:iconSize="15dp"
                    app:iconGravity="textStart" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
